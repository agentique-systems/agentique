+#[test]
+fn initial_certificate_reuses_topology_without_reusing_pending_or_completed_proofs() {
+    let snapshot = fixture(&[(1, c::FEATURE), (2, c::FEATURE), (3, c::TYPE)]);
+    let registry = registry(ProducerEffect::Typing);
+    let context = context(&snapshot, &registry);
+    let mut builder = ClosureCertificateBuilder::default();
+    let initial = builder.initial(&context, &registry).unwrap();
+    initial.assert_exact(&ProducerClosureCertificate::initial(&context, &registry).unwrap());
+    assert!(!initial.is_closed(id(1), SemanticClosureRequirement::EffectiveTyping));
+    let built = builder.cache.topology_rebuilt;
+    assert_eq!(built, snapshot.model().len());
+    let row = builder.cache.topology[&id(1)].clone();
+
+    let mut complete = table(&snapshot, &registry);
+    for subject in [id(1), id(2)] {
+        complete
+            .record(&[(subject, FAMILY, Completeness::Complete)], &registry)
+            .unwrap();
+        complete.record_reads(
+            &[(
+                subject,
+                FAMILY,
+                vec![ProducerRead::Identity(subject)].into(),
+            )],
+            &registry,
+        );
+    }
+    let finished = compare(&mut builder, &snapshot, &registry, &complete, &[]);
+    assert!(finished.is_fully_closed(snapshot.model()));
+    assert_eq!(built, builder.cache.topology_rebuilt);
+    assert!(Arc::ptr_eq(&row, &builder.cache.topology[&id(1)]));
+
+    // Reinitializing cannot carry the preceding completed evaluations forward.
+    let reset = builder.initial(&context, &registry).unwrap();
+    reset.assert_exact(&initial);
+    assert!(!reset.is_closed(id(1), SemanticClosureRequirement::EffectiveTyping));
+    assert_eq!(built, builder.cache.topology_rebuilt);
+}
