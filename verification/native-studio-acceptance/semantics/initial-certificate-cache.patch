+    let snapshot = fixture(&[(1, c::FEATURE), (2, c::TYPE)]);
+    let registry = registry(ProducerEffect::Typing);
+    let initial_context = context(&snapshot, &registry);
+    let mut builder = ClosureCertificateBuilder::default();
+    let initial = builder.initial(&initial_context, &registry).unwrap();
+    let prior_row = builder.cache.topology[&id(1)].clone();
+    let foreign = ProducerRegistry::new([]).unwrap();
+    assert_eq!(
